rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatars: authenticated user can read anyone's avatar, write only their own
    match /avatars/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && fileName.matches('^' + request.auth.uid + '\\..+$')
                   && request.resource.size < 5 * 1024 * 1024   // 5 MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Posts: authenticated user can read all, write only under their own uid
    match /posts/{userId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB max
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
